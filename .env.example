# Copy this file to .env and fill in your values.
# The graph reads LLM_PROVIDER at startup via get_llm() in llm/ollama_client.py.

# ---- Provider selection ----
# "ollama" for local dev, "huggingface" for cloud deployment (e.g. HF Spaces),
# "nous" for Nous Research Portal (https://portal.nousresearch.com),
# "openai_compatible" for any other OpenAI-compatible endpoint (Together,
# Fireworks, OpenRouter, vLLM, ...) — configured entirely by the env vars below.
LLM_PROVIDER=ollama

# ---- Ollama (local) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- Hugging Face Inference API ----
# Create a token at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- Nous Research Portal ----
# Generate an API key at https://portal.nousresearch.com
# Model IDs are listed at https://portal.nousresearch.com/api-docs
# NOUS_API_KEY=nousresearch_xxxxxxxxxxxxxxxx
# NOUS_MODEL=hermes-3-llama-3.1-70b

# ---- Generic OpenAI-compatible endpoint ----
# Set LLM_PROVIDER=openai_compatible and point these at any OpenAI-compatible
# API. All three are required; there is no default model.
# OPENAI_BASE_URL=https://api.together.xyz/v1
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Optional: LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_key_here
# LANGCHAIN_PROJECT=auspex
