# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Secrets can also be passed via env vars: TF_VAR_db_password, TF_VAR_mcp_token,
# TF_VAR_llm_api_key.

project_id = "your-gcp-project-id"
region     = "us-central1"
app_name   = "auspex-mcp"

# --- secrets (do NOT commit real values) ---
db_password = "change-me-strong-db-password"
mcp_token   = "change-me-long-random-bearer-token"

# --- LLM provider (see llm/ollama_client.py for provider names + key env vars) ---
llm_provider    = "openai_compatible"
llm_api_key_env = "OPENAI_API_KEY"
llm_api_key     = "sk-..."

# Image tag Cloud Run deploys (push this tag to Artifact Registry first).
image_tag = "latest"
